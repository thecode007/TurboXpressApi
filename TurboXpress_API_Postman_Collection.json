      "name": "Authentication",
      "item": [
        {
          "name": "Basic Login",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+1234567890\",\n  \"password\": \"yourpassword\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "api", "auth", "login" ] }
          }
        },
        {
          "name": "Basic Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": [ "{{baseUrl}}" ], "path": [ "api", "auth", "logout" ] }
          }
        },
        {
          "name": "Firebase Login",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firebaseToken\": \"YOUR_FIREBASE_ID_TOKEN\",\n  \"targetRole\": \"CUSTOMER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/firebase/login", "host": [ "{{baseUrl}}" ], "path": [ "api", "auth", "firebase", "login" ] }
          }
        },
        {
          "name": "Verify Firebase Token",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firebaseIdToken\": \"YOUR_FIREBASE_ID_TOKEN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/verify-firebase-token", "host": [ "{{baseUrl}}" ], "path": [ "api", "auth", "verify-firebase-token" ] }
          }
        }
      ]
